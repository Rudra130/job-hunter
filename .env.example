# =====================================================================
# JobPilot AI — Environment Configuration Example
# =====================================================================

# -----------------
# 1. Core Backend
# -----------------
PROJECT_NAME="JobPilot AI"
SECRET_KEY="jobpilot-super-secret-production-key-change-in-env-32bytes"
API_V1_STR="/api/v1"

# Database Configuration:
# For production PostgreSQL with pgvector:
# DATABASE_URL="postgresql://jobpilot_user:jobpilot_password@localhost:5432/jobpilot_db"
# For zero-config instant local dev:
DATABASE_URL="sqlite:///./jobpilot.db"

# Redis Queue Configuration:
REDIS_URL="redis://localhost:6379/0"

# -----------------
# 2. AI & LLM Inference (NVIDIA NIM / OpenAI / Anthropic / Local)
# -----------------
# NVIDIA NIM or OpenAI compatible key:
OPENAI_API_KEY="your-api-key-here"

# NVIDIA NIM base URL (or https://api.openai.com/v1 for standard OpenAI):
OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"

# LLM model identifier:
LLM_MODEL="meta/llama-3.1-70b-instruct"

# Embedding model identifier for vector semantic search:
EMBEDDING_MODEL="nvidia/nv-embed-v1"

# Set to true to enable mock AI fallback responses when keys are empty
MOCK_AI_RESPONSES="true"

# -----------------
# 3. Frontend Configuration
# -----------------
NEXT_PUBLIC_API_URL="http://localhost:8000"
